    (kache)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:kache-command-$line[1]:"
        case $line[1] in
            (cargo)
_arguments "${_arguments_options[@]}" : \
'--json[Machine-readable JSON on stdout, on commands that support it]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- Built-in build/check arguments passed verbatim to Cargo (use `--` first):_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--sort=[Sort by\: name, size, hits, age]:SORT:_default' \
'--no-pager[Print directly instead of using a pager]' \
