(( $+functions[_kache_commands] )) ||
_kache_commands() {
    local commands; commands=(
'cargo:Run Cargo with canonical duplicate Cargo-home rustflags collapsed once' \
'list:List cache entries, or one crate'\''s entries in detail' \
'gc:Evict cache entries by the size and age limits, as the daemon does. Kept for scripts' \
'purge:Remove the whole cache or one crate'\''s entries. Kept for scripts; \`kache clean --cache\` empties the cache too' \
'clean:Free disk space\: remove old target directories, or empty the cache' \
'targets:Show tracked target directories. Kept for scripts; \`kache clean --dry-run\` shows the same targets' \
'init:Set up caching for Cargo and C/C++ builds' \
'doctor:Diagnose setup issues and verify cache integrity' \
'sync:Pull from and push to the configured remote' \
'save-manifest:Save a build manifest for future prefetch warming' \
'daemon:Show the background daemon'\''s status, or start, stop or install it' \
'monitor:Live dashboard of builds and the cache' \
'stats:Hit rate, time saved and cache size; --full for the whole report' \
'telemetry:Write cache counters as OTLP JSON for Kartero to import later' \
'explain:Explain why a crate, or the latest build, missed the cache' \
'diff:Compare misses in the two newest sessions of one build root. Kept for scripts; \`kache explain\` with no crate explains the same build' \
'report:The full build report. Kept for scripts; \`kache stats --full\` is the same report' \
'config:Open the configuration editor' \
'login:Log in to the planner with your Kunobi account' \
'logout:Log out of the planner and revoke the stored Kunobi session' \
