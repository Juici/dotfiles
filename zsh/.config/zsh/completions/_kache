_kache_commands() {
    local commands; commands=(
'list:List cache entries, or one crate'\''s entries in detail' \
'clean:Free disk space\: remove old target directories, or empty the cache' \
'init:Set up caching for Cargo and C/C++ builds' \
'doctor:Diagnose setup issues and verify cache integrity' \
'sync:Pull from and push to the configured remote' \
'daemon:Show the background daemon'\''s status, or start, stop or install it' \
'monitor:Watch builds and the cache live' \
'stats:Show hit rate, time saved and cache size; --full for the whole report' \
'status:Show hit rate, time saved and cache size; --full for the whole report' \
'explain:Explain why a crate, or the latest build, missed the cache' \
'config:Edit or inspect configuration (opens the editor without a subcommand)' \
'login:Log in to the planner with your Kunobi account' \
'logout:Log out of the planner and revoke the stored Kunobi session' \
'completions:Generate shell completion scripts' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'kache commands' commands "$@"
}
