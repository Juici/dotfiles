# vim:ft=gitconfig

[color]
	pager = true

[core]
	autocrlf = false
	whitespace = 'tabwidth=4'

[user]
	signingKey = 5283B069B646BDF63B6C0C27F03278A61EEDB2CA
	name = James Whaley
	email = juicy66173@gmail.com

[commit]
	gpgSign = true
[tag]
	gpgSign = true

[push]
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	ff = only

[init]
	defaultBranch = master


[diff "pdf"]
	binary = true
	textconv = pdf2text
[diff "doc"]
	binary = true
	textconv = catdoc
[diff "odf"]
	binary = true
	textconv = odt2txt

[include]
	path = config.local
